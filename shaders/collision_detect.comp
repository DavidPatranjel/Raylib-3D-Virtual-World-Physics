#version 430

layout(local_size_x = 16, local_size_y = 16) in;

struct PhysicsData {
    vec3 position;
    float padding1;
    vec3 velocity;
    float padding2;
    vec3 rotationAxis;
    float radius;
    int objectType;
    int collisionFlag;
    vec2 padding3;
};

layout(std430, binding = 0) buffer PhysicsBuffer {
    PhysicsData objects[];
};

uniform int objectCount;

// Object types (must match C++ enum ObjectType)
const int TYPE_SPHERE = 0;
const int TYPE_CUBE = 1;
const int TYPE_CYLINDER = 2;

// ============================================================================
// Collision Detection Functions
// ============================================================================

// Sphere-Sphere: Simple distance check
bool checkSphereSphere(vec3 posA, float radiusA, vec3 posB, float radiusB) {
    vec3 diff = posB - posA;
    float distSq = dot(diff, diff);
    float radiusSum = radiusA + radiusB;
    return distSq <= radiusSum * radiusSum;
}

// Sphere-AABB (Cube): Find closest point on cube to sphere center
bool checkSphereCube(vec3 spherePos, float sphereRadius, vec3 cubePos, float cubeHalf) {
    // Clamp sphere center to cube bounds to find closest point
    vec3 closestPoint;
    closestPoint.x = clamp(spherePos.x, cubePos.x - cubeHalf, cubePos.x + cubeHalf);
    closestPoint.y = clamp(spherePos.y, cubePos.y - cubeHalf, cubePos.y + cubeHalf);
    closestPoint.z = clamp(spherePos.z, cubePos.z - cubeHalf, cubePos.z + cubeHalf);
    
    // Check if closest point is within sphere radius
    vec3 diff = closestPoint - spherePos;
    float distSq = dot(diff, diff);
    return distSq <= sphereRadius * sphereRadius;
}

// Sphere-Cylinder: Cylinder aligned along Y axis
bool checkSphereCylinder(vec3 spherePos, float sphereRadius, vec3 cylPos, float cylRadius, float cylHalfHeight) {
    // Clamp sphere's Y to cylinder's height range
    float clampedY = clamp(spherePos.y, cylPos.y - cylHalfHeight, cylPos.y + cylHalfHeight);
    
    // Distance in XZ plane from sphere to cylinder axis
    vec2 diffXZ = spherePos.xz - cylPos.xz;
    float distXZ = length(diffXZ);
    
    // Find closest point on cylinder surface
    vec3 closestPoint;
    if (distXZ <= 0.0001) {
        // Sphere is on cylinder axis - closest point is directly above/below
        closestPoint = vec3(cylPos.x, clampedY, cylPos.z);
    } else if (distXZ <= cylRadius) {
        // Sphere center is inside cylinder's XZ projection
        // Closest point is on a cap (top or bottom)
        closestPoint = vec3(spherePos.x, clampedY, spherePos.z);
    } else {
        // Closest point is on the curved surface
        vec2 dirXZ = diffXZ / distXZ;
        closestPoint = vec3(cylPos.x + dirXZ.x * cylRadius, clampedY, cylPos.z + dirXZ.y * cylRadius);
    }
    
    vec3 diff = closestPoint - spherePos;
    float distSq = dot(diff, diff);
    return distSq <= sphereRadius * sphereRadius;
}

// AABB-AABB (Cube-Cube): Overlap test on all three axes
bool checkCubeCube(vec3 posA, float halfA, vec3 posB, float halfB) {
    return abs(posA.x - posB.x) <= halfA + halfB &&
           abs(posA.y - posB.y) <= halfA + halfB &&
           abs(posA.z - posB.z) <= halfA + halfB;
}

// Cube-Cylinder: Box vs cylinder (both axis-aligned)
bool checkCubeCylinder(vec3 cubePos, float cubeHalf, vec3 cylPos, float cylRadius, float cylHalfHeight) {
    // First check Y overlap (1D interval test)
    if (abs(cubePos.y - cylPos.y) > cubeHalf + cylHalfHeight) {
        return false;
    }
    
    // Check XZ as 2D rectangle vs circle
    // Find closest point on cube's XZ face to cylinder axis
    float closestX = clamp(cylPos.x, cubePos.x - cubeHalf, cubePos.x + cubeHalf);
    float closestZ = clamp(cylPos.z, cubePos.z - cubeHalf, cubePos.z + cubeHalf);
    
    float dx = closestX - cylPos.x;
    float dz = closestZ - cylPos.z;
    float distSqXZ = dx * dx + dz * dz;
    
    return distSqXZ <= cylRadius * cylRadius;
}

// Cylinder-Cylinder: Both axis-aligned along Y
bool checkCylinderCylinder(vec3 posA, float radiusA, float halfHeightA, vec3 posB, float radiusB, float halfHeightB) {
    // Check Y overlap (1D interval test)
    if (abs(posA.y - posB.y) > halfHeightA + halfHeightB) {
        return false;
    }
    
    // Check XZ as 2D circle-circle collision
    vec2 diffXZ = posA.xz - posB.xz;
    float distSqXZ = dot(diffXZ, diffXZ);
    float radiusSumXZ = radiusA + radiusB;
    
    return distSqXZ <= radiusSumXZ * radiusSumXZ;
}

// ============================================================================
// Main
// ============================================================================

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint j = gl_GlobalInvocationID.y;

    // Only check upper triangle of collision matrix (avoid duplicates)
    if (i >= objectCount || j >= objectCount || i >= j)
        return;

    PhysicsData objA = objects[i];
    PhysicsData objB = objects[j];

    // Broad phase: conservative bounding sphere check (use sqrt(3) factor for cube corners)
    vec3 diff = objB.position - objA.position;
    float distSq = dot(diff, diff);
    float maxRadius = max(objA.radius, objB.radius) * 1.8; // sqrt(3) ≈ 1.73, use 1.8 for safety
    float broadPhaseRadius = maxRadius + maxRadius;
    
    if (distSq > broadPhaseRadius * broadPhaseRadius)
        return;

    // Narrow phase: proper collision detection based on object types
    bool collision = false;
    
    int typeA = objA.objectType;
    int typeB = objB.objectType;
    
    // Note: For all current primitives, radius stores:
    // - Sphere: actual radius
    // - Cube: half-extent (same on all axes)
    // - Cylinder: max(cylinder_radius, half_height) - both happen to be equal
    
    if (typeA == TYPE_SPHERE && typeB == TYPE_SPHERE) {
        collision = checkSphereSphere(objA.position, objA.radius, objB.position, objB.radius);
    }
    else if (typeA == TYPE_SPHERE && typeB == TYPE_CUBE) {
        collision = checkSphereCube(objA.position, objA.radius, objB.position, objB.radius);
    }
    else if (typeA == TYPE_CUBE && typeB == TYPE_SPHERE) {
        collision = checkSphereCube(objB.position, objB.radius, objA.position, objA.radius);
    }
    else if (typeA == TYPE_SPHERE && typeB == TYPE_CYLINDER) {
        // For cylinder: radius = cylRadius = cylHalfHeight (both 0.1)
        collision = checkSphereCylinder(objA.position, objA.radius, objB.position, objB.radius, objB.radius);
    }
    else if (typeA == TYPE_CYLINDER && typeB == TYPE_SPHERE) {
        collision = checkSphereCylinder(objB.position, objB.radius, objA.position, objA.radius, objA.radius);
    }
    else if (typeA == TYPE_CUBE && typeB == TYPE_CUBE) {
        collision = checkCubeCube(objA.position, objA.radius, objB.position, objB.radius);
    }
    else if (typeA == TYPE_CUBE && typeB == TYPE_CYLINDER) {
        collision = checkCubeCylinder(objA.position, objA.radius, objB.position, objB.radius, objB.radius);
    }
    else if (typeA == TYPE_CYLINDER && typeB == TYPE_CUBE) {
        collision = checkCubeCylinder(objB.position, objB.radius, objA.position, objA.radius, objA.radius);
    }
    else if (typeA == TYPE_CYLINDER && typeB == TYPE_CYLINDER) {
        collision = checkCylinderCylinder(objA.position, objA.radius, objA.radius, 
                                          objB.position, objB.radius, objB.radius);
    }

    if (collision) {
        objects[i].collisionFlag = 1;
        objects[j].collisionFlag = 1;
    }
}
