#version 430

layout(local_size_x = 16, local_size_y = 16) in;

struct PhysicsData {
    vec3 position;
    float rotationAngle;
    vec3 velocity;
    float rotationSpeed;
    vec3 rotationAxis;
    float radius;
    int objectType;
    int collisionFlag;
    vec2 padding3;
};

layout(std430, binding = 0) buffer PhysicsBuffer {
    PhysicsData objects[];
};

uniform int objectCount;

// Object types (must match C++ enum ObjectType)
const int TYPE_SPHERE = 0;
const int TYPE_CUBE = 1;
const int TYPE_CYLINDER = 2;

// ============================================================================
// Rotation Matrix Utilities
// ============================================================================

// Build rotation matrix from axis-angle (Rodrigues' rotation formula)
mat3 rotationMatrix(vec3 axis, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    float t = 1.0 - c;
    vec3 n = normalize(axis);
    
    return mat3(
        t * n.x * n.x + c,       t * n.x * n.y - s * n.z, t * n.x * n.z + s * n.y,
        t * n.x * n.y + s * n.z, t * n.y * n.y + c,       t * n.y * n.z - s * n.x,
        t * n.x * n.z - s * n.y, t * n.y * n.z + s * n.x, t * n.z * n.z + c
    );
}

// Get the 3 local axes of an oriented object
void getLocalAxes(vec3 rotAxis, float rotAngle, out vec3 axisX, out vec3 axisY, out vec3 axisZ) {
    mat3 rot = rotationMatrix(rotAxis, rotAngle);
    axisX = rot[0];  // First column = local X axis in world space
    axisY = rot[1];  // Second column = local Y axis in world space
    axisZ = rot[2];  // Third column = local Z axis in world space
}

// Transform point from world to local space
vec3 worldToLocal(vec3 point, vec3 center, mat3 rot) {
    return transpose(rot) * (point - center);
}

// ============================================================================
// SAT (Separating Axis Theorem) Helper
// ============================================================================

// Project OBB onto axis and return min/max
void projectOBB(vec3 center, vec3 axisX, vec3 axisY, vec3 axisZ, float halfExtent, vec3 axis, out float minProj, out float maxProj) {
    float centerProj = dot(center, axis);
    float extentProj = halfExtent * (abs(dot(axisX, axis)) + abs(dot(axisY, axis)) + abs(dot(axisZ, axis)));
    minProj = centerProj - extentProj;
    maxProj = centerProj + extentProj;
}

// Project cylinder onto axis
void projectCylinder(vec3 center, vec3 axisY, float cylRadius, float cylHalfHeight, vec3 axis, out float minProj, out float maxProj) {
    float centerProj = dot(center, axis);
    
    // Height contribution along cylinder's Y axis
    float heightProj = cylHalfHeight * abs(dot(axisY, axis));
    
    // Radius contribution perpendicular to cylinder's Y axis
    vec3 perpComponent = axis - dot(axis, axisY) * axisY;
    float perpLen = length(perpComponent);
    float radiusProj = cylRadius * perpLen;
    
    float extent = heightProj + radiusProj;
    minProj = centerProj - extent;
    maxProj = centerProj + extent;
}

// Check if projections overlap
bool projectionsOverlap(float minA, float maxA, float minB, float maxB) {
    return !(maxA < minB || maxB < minA);
}

// ============================================================================
// Collision Detection Functions
// ============================================================================

// Sphere-Sphere: Simple distance check (rotation doesn't matter)
bool checkSphereSphere(vec3 posA, float radiusA, vec3 posB, float radiusB) {
    vec3 diff = posB - posA;
    float distSq = dot(diff, diff);
    float radiusSum = radiusA + radiusB;
    return distSq <= radiusSum * radiusSum;
}

// Sphere-OBB: Transform sphere to OBB local space, then AABB check
bool checkSphereOBB(vec3 spherePos, float sphereRadius, vec3 obbPos, float obbHalf, vec3 obbAxisX, vec3 obbAxisY, vec3 obbAxisZ) {
    // Transform sphere center to OBB local space
    vec3 localSphere = vec3(
        dot(spherePos - obbPos, obbAxisX),
        dot(spherePos - obbPos, obbAxisY),
        dot(spherePos - obbPos, obbAxisZ)
    );
    
    // Clamp to OBB bounds to find closest point
    vec3 closestPoint;
    closestPoint.x = clamp(localSphere.x, -obbHalf, obbHalf);
    closestPoint.y = clamp(localSphere.y, -obbHalf, obbHalf);
    closestPoint.z = clamp(localSphere.z, -obbHalf, obbHalf);
    
    // Check distance in local space
    vec3 diff = closestPoint - localSphere;
    float distSq = dot(diff, diff);
    return distSq <= sphereRadius * sphereRadius;
}

// Sphere-Oriented Cylinder
bool checkSphereOrientedCylinder(vec3 spherePos, float sphereRadius, vec3 cylPos, float cylRadius, float cylHalfHeight, vec3 cylAxisX, vec3 cylAxisY, vec3 cylAxisZ) {
    // Transform sphere to cylinder local space (cylinder axis is Y)
    vec3 localSphere = vec3(
        dot(spherePos - cylPos, cylAxisX),
        dot(spherePos - cylPos, cylAxisY),
        dot(spherePos - cylPos, cylAxisZ)
    );
    
    // Clamp Y to cylinder height
    float clampedY = clamp(localSphere.y, -cylHalfHeight, cylHalfHeight);
    
    // Distance in XZ plane
    float distXZ = length(vec2(localSphere.x, localSphere.z));
    
    vec3 closestPoint;
    if (distXZ <= 0.0001) {
        closestPoint = vec3(0.0, clampedY, 0.0);
    } else if (distXZ <= cylRadius) {
        closestPoint = vec3(localSphere.x, clampedY, localSphere.z);
    } else {
        vec2 dirXZ = vec2(localSphere.x, localSphere.z) / distXZ;
        closestPoint = vec3(dirXZ.x * cylRadius, clampedY, dirXZ.y * cylRadius);
    }
    
    vec3 diff = closestPoint - localSphere;
    float distSq = dot(diff, diff);
    return distSq <= sphereRadius * sphereRadius;
}

// OBB-OBB: Separating Axis Theorem with 15 axes
bool checkOBBOBB(vec3 posA, float halfA, vec3 axA_X, vec3 axA_Y, vec3 axA_Z,
                 vec3 posB, float halfB, vec3 axB_X, vec3 axB_Y, vec3 axB_Z) {
    
    float minA, maxA, minB, maxB;
    
    // Test 3 axes from box A
    vec3 axes[15];
    axes[0] = axA_X;
    axes[1] = axA_Y;
    axes[2] = axA_Z;
    
    // Test 3 axes from box B
    axes[3] = axB_X;
    axes[4] = axB_Y;
    axes[5] = axB_Z;
    
    // Test 9 cross product axes
    axes[6] = cross(axA_X, axB_X);
    axes[7] = cross(axA_X, axB_Y);
    axes[8] = cross(axA_X, axB_Z);
    axes[9] = cross(axA_Y, axB_X);
    axes[10] = cross(axA_Y, axB_Y);
    axes[11] = cross(axA_Y, axB_Z);
    axes[12] = cross(axA_Z, axB_X);
    axes[13] = cross(axA_Z, axB_Y);
    axes[14] = cross(axA_Z, axB_Z);
    
    for (int i = 0; i < 15; i++) {
        vec3 axis = axes[i];
        float axisLen = length(axis);
        
        // Skip degenerate axes (parallel edges)
        if (axisLen < 0.0001) continue;
        
        axis = axis / axisLen;
        
        projectOBB(posA, axA_X, axA_Y, axA_Z, halfA, axis, minA, maxA);
        projectOBB(posB, axB_X, axB_Y, axB_Z, halfB, axis, minB, maxB);
        
        if (!projectionsOverlap(minA, maxA, minB, maxB)) {
            return false;  // Found separating axis
        }
    }
    
    return true;  // No separating axis found = collision
}

// OBB-Cylinder: SAT with multiple axes
bool checkOBBCylinder(vec3 obbPos, float obbHalf, vec3 obbAxisX, vec3 obbAxisY, vec3 obbAxisZ,
                      vec3 cylPos, float cylRadius, float cylHalfHeight, vec3 cylAxisX, vec3 cylAxisY, vec3 cylAxisZ) {
    
    float minA, maxA, minB, maxB;
    
    // Axes to test:
    // - 3 OBB face normals
    // - 1 cylinder axis (cylAxisY)
    // - 3 cross products of OBB edges with cylinder axis
    // - Direction from OBB center to cylinder axis (for edge cases)
    
    vec3 axes[8];
    axes[0] = obbAxisX;
    axes[1] = obbAxisY;
    axes[2] = obbAxisZ;
    axes[3] = cylAxisY;
    axes[4] = cross(obbAxisX, cylAxisY);
    axes[5] = cross(obbAxisY, cylAxisY);
    axes[6] = cross(obbAxisZ, cylAxisY);
    
    // Direction from OBB to cylinder (projected onto plane perpendicular to cylinder axis)
    vec3 d = cylPos - obbPos;
    vec3 dPerp = d - dot(d, cylAxisY) * cylAxisY;
    axes[7] = length(dPerp) > 0.0001 ? normalize(dPerp) : obbAxisX;
    
    for (int i = 0; i < 8; i++) {
        vec3 axis = axes[i];
        float axisLen = length(axis);
        
        if (axisLen < 0.0001) continue;
        axis = axis / axisLen;
        
        projectOBB(obbPos, obbAxisX, obbAxisY, obbAxisZ, obbHalf, axis, minA, maxA);
        projectCylinder(cylPos, cylAxisY, cylRadius, cylHalfHeight, axis, minB, maxB);
        
        if (!projectionsOverlap(minA, maxA, minB, maxB)) {
            return false;
        }
    }
    
    return true;
}

// Cylinder-Cylinder: SAT
bool checkCylinderCylinder(vec3 posA, float radiusA, float halfHeightA, vec3 axA_X, vec3 axA_Y, vec3 axA_Z,
                           vec3 posB, float radiusB, float halfHeightB, vec3 axB_X, vec3 axB_Y, vec3 axB_Z) {
    
    float minA, maxA, minB, maxB;
    
    // Axes to test:
    // - 2 cylinder axes (axA_Y and axB_Y)
    // - Cross product of the two cylinder axes
    // - Direction between cylinder centers projected perpendicular to each axis
    
    vec3 axes[5];
    axes[0] = axA_Y;
    axes[1] = axB_Y;
    axes[2] = cross(axA_Y, axB_Y);
    
    // Direction between centers
    vec3 d = posB - posA;
    
    // Direction perpendicular to cylinder A's axis
    vec3 dPerpA = d - dot(d, axA_Y) * axA_Y;
    axes[3] = length(dPerpA) > 0.0001 ? normalize(dPerpA) : axA_X;
    
    // Direction perpendicular to cylinder B's axis
    vec3 dPerpB = d - dot(d, axB_Y) * axB_Y;
    axes[4] = length(dPerpB) > 0.0001 ? normalize(dPerpB) : axB_X;
    
    for (int i = 0; i < 5; i++) {
        vec3 axis = axes[i];
        float axisLen = length(axis);
        
        if (axisLen < 0.0001) continue;
        axis = axis / axisLen;
        
        projectCylinder(posA, axA_Y, radiusA, halfHeightA, axis, minA, maxA);
        projectCylinder(posB, axB_Y, radiusB, halfHeightB, axis, minB, maxB);
        
        if (!projectionsOverlap(minA, maxA, minB, maxB)) {
            return false;
        }
    }
    
    return true;
}

// ============================================================================
// Main
// ============================================================================

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint j = gl_GlobalInvocationID.y;

    // Only check upper triangle of collision matrix (avoid duplicates)
    if (i >= objectCount || j >= objectCount || i >= j)
        return;

    PhysicsData objA = objects[i];
    PhysicsData objB = objects[j];

    // Broad phase: conservative bounding sphere check
    vec3 diff = objB.position - objA.position;
    float distSq = dot(diff, diff);
    float maxRadius = max(objA.radius, objB.radius) * 2.0;  // Conservative for rotated objects
    float broadPhaseRadius = maxRadius + maxRadius;
    
    if (distSq > broadPhaseRadius * broadPhaseRadius)
        return;

    // Get local axes for both objects
    vec3 axA_X, axA_Y, axA_Z;
    vec3 axB_X, axB_Y, axB_Z;
    getLocalAxes(objA.rotationAxis, objA.rotationAngle, axA_X, axA_Y, axA_Z);
    getLocalAxes(objB.rotationAxis, objB.rotationAngle, axB_X, axB_Y, axB_Z);

    // Narrow phase: proper collision detection based on object types
    bool collision = false;
    
    int typeA = objA.objectType;
    int typeB = objB.objectType;
    
    if (typeA == TYPE_SPHERE && typeB == TYPE_SPHERE) {
        collision = checkSphereSphere(objA.position, objA.radius, objB.position, objB.radius);
    }
    else if (typeA == TYPE_SPHERE && typeB == TYPE_CUBE) {
        collision = checkSphereOBB(objA.position, objA.radius, objB.position, objB.radius, axB_X, axB_Y, axB_Z);
    }
    else if (typeA == TYPE_CUBE && typeB == TYPE_SPHERE) {
        collision = checkSphereOBB(objB.position, objB.radius, objA.position, objA.radius, axA_X, axA_Y, axA_Z);
    }
    else if (typeA == TYPE_SPHERE && typeB == TYPE_CYLINDER) {
        collision = checkSphereOrientedCylinder(objA.position, objA.radius, objB.position, objB.radius, objB.radius, axB_X, axB_Y, axB_Z);
    }
    else if (typeA == TYPE_CYLINDER && typeB == TYPE_SPHERE) {
        collision = checkSphereOrientedCylinder(objB.position, objB.radius, objA.position, objA.radius, objA.radius, axA_X, axA_Y, axA_Z);
    }
    else if (typeA == TYPE_CUBE && typeB == TYPE_CUBE) {
        collision = checkOBBOBB(objA.position, objA.radius, axA_X, axA_Y, axA_Z,
                                objB.position, objB.radius, axB_X, axB_Y, axB_Z);
    }
    else if (typeA == TYPE_CUBE && typeB == TYPE_CYLINDER) {
        collision = checkOBBCylinder(objA.position, objA.radius, axA_X, axA_Y, axA_Z,
                                     objB.position, objB.radius, objB.radius, axB_X, axB_Y, axB_Z);
    }
    else if (typeA == TYPE_CYLINDER && typeB == TYPE_CUBE) {
        collision = checkOBBCylinder(objB.position, objB.radius, axB_X, axB_Y, axB_Z,
                                     objA.position, objA.radius, objA.radius, axA_X, axA_Y, axA_Z);
    }
    else if (typeA == TYPE_CYLINDER && typeB == TYPE_CYLINDER) {
        collision = checkCylinderCylinder(objA.position, objA.radius, objA.radius, axA_X, axA_Y, axA_Z,
                                          objB.position, objB.radius, objB.radius, axB_X, axB_Y, axB_Z);
    }

    if (collision) {
        objects[i].collisionFlag = 1;
        objects[j].collisionFlag = 1;
    }
}
